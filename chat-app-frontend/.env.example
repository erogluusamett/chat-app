# Backend REST API base URL
# Geliştirme ortamında vite proxy kullandığı için boş bırakılır.
# Production'da backend adresinizi yazın: https://api.siteadiniz.com
VITE_API_BASE_URL=

# WebSocket endpoint
# Geliştirme: /ws  (vite proxy devrede)
# Production: ws://api.siteadiniz.com/ws
VITE_WS_URL=/ws
